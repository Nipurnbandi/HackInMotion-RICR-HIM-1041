APP_NAME=Hack API
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# PostgreSQL — update user, password, host, port, db name to match your local server
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hack

JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Photo evidence storage (local disk in development).
# Swap app/core/storage.py for an S3-compatible backend in production.
UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# Department notifications.
# console = print to server log (development), email = real SMTP delivery.
NOTIFIER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartCity Reports <noreply@city.gov>

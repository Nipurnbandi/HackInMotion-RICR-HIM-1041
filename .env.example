# Configuration for the Dockerised backend (docker-compose.yml).
# Copy to `.env` next to docker-compose.yml and edit before deploying.
# For local backend development without Docker, use backend/.env.example instead.

# ── Database ────────────────────────────────────────────────────────────────
# Credentials for the bundled PostgreSQL container. Change them for anything
# reachable from outside your machine.
POSTGRES_USER=smartcity
POSTGRES_PASSWORD=smartcity
POSTGRES_DB=smartcity

# ── Security ────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── HTTP ────────────────────────────────────────────────────────────────────
# Host port the API is published on.
API_PORT=8000

# Browser origins allowed to call this API. The auth cookie is SameSite=Lax,
# so a frontend on a different origin will not be able to send it — serve the
# frontend from this same origin, or put both behind one domain.
CORS_ORIGINS=http://localhost:5173

# ── First administrator ─────────────────────────────────────────────────────
# Set both and the container creates this account on startup if it is missing.
# Password must be at least 8 characters. Safe to leave set: existing accounts
# are never modified.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Uploads ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=5242880

# ── Notifications ───────────────────────────────────────────────────────────
# console = write to the container log, email = real SMTP delivery.
NOTIFIER=console

# ── AI photo verification (optional) ────────────────────────────────────────
# Without a key, photos are simply marked UNVERIFIED and nothing else changes.
ANTHROPIC_API_KEY=
PHOTO_VERIFICATION_MODEL=claude-opus-5
